#!/bin/bash
for num in "$1" "$2" " $3"
do       
        if [ $num -gt 0 ]
        then 
                echo "Positive"
        elif [ $num -lt 0 ]
        then
                echo "Negative"
        else 
                echo "Zero"
        fi

        if [ $num -eq 0 ]
        then
                echo "Even"
        elif [ $(($num%2)) -eq 0 ]
        then
                echo "Even"
        else
                echo "Odd"
        fi
done
